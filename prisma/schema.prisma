generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum AuditAction {
  PROMOTED
  DEMOTED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")

  cartItems CartItem[]
  orders    Order[]

  // Every promotion or demotion an admin performs, and every one done to
  // them. Named relations because there are two foreign keys to this same
  // table (who did it, and who it was done to).
  auditActionsDone AdminAuditLog[] @relation("AuditActor")
  auditActionsOn   AdminAuditLog[] @relation("AuditTarget")

  @@map("users")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  // Money is stored as integer cents to avoid floating point rounding errors.
  priceCents  Int       @map("price_cents")
  imageUrl    String    @map("image_url")
  stock       Int       @default(0)
  // Set when an admin archives the product. A product that has been ordered can
  // never be deleted (order_items keeps pointing at it), so "removing" one means
  // hiding it from the shop while old orders keep working. null = on sale.
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  cartItems  CartItem[]
  orderItems OrderItem[]

  // Speeds up listing the newest products first.
  @@index([createdAt])
  @@map("products")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Adding the same product twice raises the quantity instead of adding a row.
  @@unique([userId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  status     OrderStatus @default(PENDING)
  totalCents Int         @map("total_cents")
  createdAt  DateTime    @default(now()) @map("created_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  // Serves "my orders, newest first, older than this one" (getOrders in
  // lib/orders.ts), which filters on user_id and sorts by id. Order ids only go
  // up, so id order is creation order. An index that matches both the filter and
  // the sort keeps deep pages fast for users with many orders.
  @@index([userId, id])
  @@map("orders")
}

model OrderItem {
  id             Int @id @default(autoincrement())
  orderId        Int @map("order_id")
  productId      Int @map("product_id")
  quantity       Int
  // The price at purchase time, so later price changes don't rewrite old orders.
  unitPriceCents Int @map("unit_price_cents")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// One row per promotion or demotion, so "who made this account an admin, and
// when" is always answerable, never overwritten by the next change. Rows are
// never updated or deleted, only inserted.
model AdminAuditLog {
  id        Int         @id @default(autoincrement())
  actorId   Int         @map("actor_id")
  targetId  Int         @map("target_id")
  action    AuditAction
  createdAt DateTime    @default(now()) @map("created_at")

  // A user who ever appears in this log can never be deleted (there is no
  // delete-user feature in the app at all), the same rule as an order's buyer.
  actor  User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  target User @relation("AuditTarget", fields: [targetId], references: [id], onDelete: Restrict)

  // Serves "this user's own history, newest first". The site-wide log orders
  // by id too, but that is already the primary key's own index.
  @@index([targetId, id])
  @@map("admin_audit_log")
}
