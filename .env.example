# Copy this file to .env and fill in your real values. .env is git-ignored.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/buyin_it_now"

# Used to sign session cookies. Generate your own with: openssl rand -base64 32
# Never reuse this example value, and never commit the real one.
SESSION_SECRET="replace_me_with_your_own_generated_secret"
